# Kentucky AI platform image (web + worker). Debian slim + Python 3.12: PyTorch / PyG wheels are not built for Alpine,
# so the upstream Alpine image cannot host training or inference. Build: docker build -f Dockerfile.kentucky -t ka-platform .

################ frontend: Label Studio app + the embedded labeling engine served at /ka/engine/
FROM oven/bun:1.3-alpine AS frontend
ENV BUILD_NO_SERVER=true BUILD_NO_HASH=true BUILD_NO_CHUNKS=true BUILD_MODULE=true NODE_ENV=production NODE_OPTIONS="--max-old-space-size=4096"
WORKDIR /label-studio/web
RUN apk add --no-cache git
COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile
COPY web ./
RUN mkdir -p /label-studio/label_studio/core/static/js
COPY pyproject.toml ../pyproject.toml
RUN bun run build && bun --bun run vite build --config vite.config.editor.ts --base /ka/engine/

################ app
FROM python:3.12-slim
ENV LS_DIR=/label-studio HOME=/label-studio LABEL_STUDIO_BASE_DATA_DIR=/label-studio/data PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 \
    DJANGO_SETTINGS_MODULE=core.settings.label_studio PIP_NO_CACHE_DIR=1
WORKDIR $LS_DIR
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libgomp1 curl && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY label_studio ./label_studio
COPY deploy ./deploy
COPY licenses ./licenses
COPY LICENSE ./
RUN pip install -e . gunicorn==23.0.0 \
 && pip install -r label_studio/kentucky/requirements.txt --extra-index-url https://download.pytorch.org/whl/cpu
COPY --from=frontend /label-studio/web/dist ./web/dist
COPY --from=frontend /label-studio/label_studio/core/static/js/manifest.json ./label_studio/core/static/js/manifest.json
RUN useradd -u 1001 -m ka && mkdir -p $LABEL_STUDIO_BASE_DATA_DIR && chown -R 1001:0 $LS_DIR
USER 1001
EXPOSE 8080
# web by default; the worker service runs deploy/kentucky/start-worker.sh
CMD ["bash", "deploy/kentucky/start-web.sh"]
